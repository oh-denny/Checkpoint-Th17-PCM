# Copy to config/pipeline.env; paths point to external software installations.
BONSAI_REPO=/absolute/path/to/Bonsai-data-representation
SANITY_HOME=/absolute/path/to/Sanity
# PROJECT_DIR defaults to the repository root. Preserve analytical defaults.
SANITY_THREADS=8
BONSAI_MPI_PROCESSES=4
BONSAI_ZSCORE=1.0
BONSAI_KNN=10
SCOUT_PORT=8765
